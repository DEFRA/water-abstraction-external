{% extends 'layout.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block pageContent %}
  {{ govukSummaryList({
    classes: 'govuk-summary-list--no-border',
    attributes: {
      'data-test': 'meta-data'
    },
    rows: [
      {
        key: { text: 'Licence name', classes: "meta-data__label" },
        value: { html: '<span data-test="meta-data-licence-name">' + licenceName + '</span>', classes: "meta-data__value" }
      },
      {
        key: { text: 'Effective from', classes: "meta-data__label" },
        value: { html: '<span data-test="meta-data-effective-from">' + effectiveFrom + '</span>', classes: "meta-data__value" }
      },
      {
        key: { text: 'End date', classes: "meta-data__label" },
        value: { html: '<span data-test="meta-end-date">' + endDate + '</span>', classes: "meta-data__value" }
      }
    ]
  }) }}

{% endblock %}
