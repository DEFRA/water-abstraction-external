{% extends 'layout.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block pageContent %}
  <form novalidate method="post" class="govuk-!-width-one-half">
    <input type="hidden" name="wrlsCrumb" value="{{ wrlsCrumb }}"/>

    {{ govukInput({
      label: { text: "Enter a new password" },
      hint: { text: "Your password must be at least 8 characters long, and it must have an uppercase character, and a symbol." },
      id: "password",
      name: "password",
      type: "password",
      autocomplete: "new-password"
    }) }}

    {{ govukInput({
      label: { text: "Confirm your password" },
      id: "confirmPassword",
      name: "confirmPassword",
      type: "password",
      autocomplete: "new-password"
    }) }}

    {{ govukButton({ text: "Set password", isStartButton: true, preventDoubleClick: true }) }}
  </form>
{% endblock %}
